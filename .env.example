NEXT_PUBLIC_SITE_URL=https://gamedayhuddle.com
# Public origin of the server-backed API. Leave blank on GitHub Pages to use safe download/email fallbacks.
NEXT_PUBLIC_API_BASE_URL=

# Full URL the contact form posts to. The static site cannot send mail, so a
# relay would forward it to Doug. There is no relay: the marketing Function App
# at marketing.gamedayhuddle.com was deleted on 20 Aug 2026, and production
# builds this blank on purpose. Left blank, the form falls back to a prepared
# email the visitor sends themselves — which is the live behaviour today.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Stripe server-side credentials. Use test-mode values in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fixed-term prices: Coach is $99 for 5 months, Organization is $399 for
# 12 months across unlimited teams. Both are one-time prices, not recurring.
STRIPE_PRICE_COACH=
STRIPE_PRICE_ORGANIZATION=

# Comma-separated email addresses allowed into the admin workspace.
ADMIN_EMAILS=admin@gamedayhuddle.com
